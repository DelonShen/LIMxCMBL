Notebook[{

Cell[CellGroupData[{
Cell[TextData[StyleBox["Make everything super nice number (e.g. bin widths, \
chi bounds, L, etc. are integers)", "Title"]], "Chapter",
 CellChangeTimes->{{3.967297313897066*^9, 
  3.96729736746301*^9}},ExpressionUUID->"46acdb21-c755-4f3e-b7e0-\
434ffa397a5b"],

Cell["\<\
Hopefully this way Mathematica will have an easier time evaluating e.g. \
eigenvalues which it couldn\[CloseCurlyQuote]t do before from the mess that \
comes out when you have special integrals Si/Ci/Ei with fractional/irrational \
arguments

While I choose specific numbers here, the eigenvalue structure, more \
specifically the number of zero-eigenvalues, should be general\
\>", "Text",
 CellChangeTimes->{{3.96729736852334*^9, 3.967297510981166*^9}, {
  3.967297608342021*^9, 
  3.967297638844431*^9}},ExpressionUUID->"1dd6f9f4-82c9-4ea8-aae6-\
ae5541d7768b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"i", "=", "1"}], ",", "...", ",", "n"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"chimin", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"chimax", "=", "4"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"L", " ", ":=", " ", 
     RowBox[{"chimax", "-", "chimin"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nbins", " ", "=", " ", "3"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dchi", " ", ":=", " ", 
     RowBox[{"L", "/", "nbins"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"l", "[", "i_", "]"}], ":=", 
    RowBox[{"chimin", " ", "+", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"i", "-", "1"}], ")"}], "dchi"}]}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"r", "[", "i_", "]"}], ":=", 
    RowBox[{"chimin", "+", " ", 
     RowBox[{"i", " ", "dchi"}]}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fLo", "[", 
     RowBox[{"m_", ",", "\[Alpha]_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"1", "/", "L"}], " ", 
     RowBox[{
      RowBox[{"Sin", "[", 
       RowBox[{
        RowBox[{"Pi", "/", "L"}], " ", "\[Alpha]", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"2", "m"}]}], ")"}]}], "]"}], "/", 
      RowBox[{"Sin", "[", 
       RowBox[{
        RowBox[{"Pi", "/", "L"}], " ", "\[Alpha]"}], "]"}]}]}]}]}]}]], "Input",\

 CellChangeTimes->{{3.967202729986596*^9, 3.967202795205576*^9}, {
  3.967202827113571*^9, 3.967202957956501*^9}, {3.967203019163019*^9, 
  3.967203040624899*^9}, {3.967204021823441*^9, 3.967204022080085*^9}, {
  3.967204115576963*^9, 3.967204144999209*^9}, {3.96720423633923*^9, 
  3.967204239976152*^9}, {3.967205303494101*^9, 3.967205312704755*^9}, {
  3.967205363699623*^9, 3.9672053640804358`*^9}, {3.967205917706332*^9, 
  3.967205923304345*^9}, {3.967206277941879*^9, 3.9672063040977287`*^9}, {
  3.967209648205723*^9, 3.967209675212998*^9}, {3.96721225643275*^9, 
  3.967212256649044*^9}, {3.967213206501257*^9, 3.9672132066707*^9}, {
  3.967216455929266*^9, 3.967216460950891*^9}, {3.967295884615265*^9, 
  3.9672958929868517`*^9}, {3.9672962783389997`*^9, 3.967296278553516*^9}, {
  3.967296326834876*^9, 3.967296338784643*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"9a2acbce-2de3-456c-b7cd-b8986bafcd47"],

Cell[BoxData[
 RowBox[{
  RowBox[{"assume", "=", 
   RowBox[{
    RowBox[{"chimin", "\[Element]", "PositiveReals"}], "&&", 
    RowBox[{"chimax", "\[Element]", "PositiveReals"}], "&&", 
    RowBox[{"chimin", "<", "chimax"}], "&&", 
    RowBox[{"chi", "\[Element]", "PositiveReals"}], "&&", 
    RowBox[{"chip", "\[Element]", "PositiveReals"}], "&&", 
    RowBox[{"chimin", "<", "chi"}], "&&", 
    RowBox[{"chimin", "<", "chip"}], "&&", 
    RowBox[{"chi", "<", "chimax"}], "&&", 
    RowBox[{"chip", "<", "chimax"}], "&&", 
    RowBox[{"li", "\[Element]", "PositiveReals"}], "&&", 
    RowBox[{"ri", "\[Element]", "PositiveReals"}], "&&", 
    RowBox[{"li", "<", "ri"}], "&&", 
    RowBox[{"chimin", "<", "li"}], "&&", 
    RowBox[{"chimin", "<", "ri"}], "&&", 
    RowBox[{"li", "<", "chimax"}], "&&", 
    RowBox[{"ri", "<", "chimax"}], "&&", 
    RowBox[{"lj", "\[Element]", "PositiveReals"}], "&&", 
    RowBox[{"rj", "\[Element]", "PositiveReals"}], "&&", 
    RowBox[{"lj", "<", "rj"}], "&&", 
    RowBox[{"chimin", "<", "lj"}], "&&", 
    RowBox[{"chimin", "<", "rj"}], "&&", 
    RowBox[{"lj", "<", "chimax"}], "&&", 
    RowBox[{"rj", "<", "chimax"}], "&&", 
    RowBox[{"i", "\[Element]", "PositiveIntegers"}], "&&", 
    RowBox[{
     RowBox[{"chimin", "+", 
      RowBox[{"i", " ", "dchi"}]}], " ", "<=", "chimax"}], "&&", 
    RowBox[{"j", "\[Element]", "PositiveIntegers"}], "&&", 
    RowBox[{
     RowBox[{"chimin", "+", 
      RowBox[{"j", " ", "dchi"}]}], " ", "<=", "chimax"}]}]}], ";"}]], "Input",\

 CellChangeTimes->{{3.9672029618127813`*^9, 3.967202980341367*^9}, {
   3.967204203223407*^9, 3.967204230863857*^9}, {3.9672045929619646`*^9, 
