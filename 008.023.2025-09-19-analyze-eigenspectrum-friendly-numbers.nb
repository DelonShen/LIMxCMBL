Cell[CellGroupData[{

Cell["Setup functions for m > 0", "Chapter",
 CellChangeTimes->{{3.967297061379592*^9, 
  3.967297072817568*^9}},ExpressionUUID->"8d2b8cbe-27bf-4daa-a345-\
dafdb6a1bde3"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"$Assumptions", "=", "assume"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fCrossUnbinned", "[", 
    RowBox[{"m_", ",", "chi_", ",", "chip_"}], "]"}], ":=", 
   RowBox[{"Evaluate", "[", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{"fLo", "[", 
       RowBox[{"m", ",", 
        RowBox[{"chi", "-", "chip"}]}], "]"}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"1", "/", 
         RowBox[{"chi", "^", "2"}]}], "+", 
        RowBox[{"1", "/", 
         RowBox[{"chip", "^", "2"}]}]}], ")"}]}], "]"}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fLoLoIntegrand", "[", 
    RowBox[{"m_", ",", "chi_", ",", "chip_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Evaluate", "[", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{"1", "/", 
       RowBox[{"chib", "^", "2"}]}], "  ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"fLo", "[", 
         RowBox[{"m", ",", " ", 
          RowBox[{"(", 
           RowBox[{"chi", "-", "chib"}], ")"}]}], "]"}], 
        RowBox[{"fLo", "[", 
         RowBox[{"m", ",", 
          RowBox[{"(", 
           RowBox[{"chip", "-", "chib"}], ")"}]}], "]"}]}], ")"}]}], "]"}], 
    "]"}]}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"consistency", " ", "check", " ", "with", " ", "m"}], "=", "0"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Integrate", "[", 
    RowBox[{
     RowBox[{"fLoLoIntegrand", "[", 
      RowBox[{"0", ",", "chi", ",", "chip"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"chib", ",", "chimin", ",", "chimax"}], "}"}]}], "]"}], "==", 
   RowBox[{
    RowBox[{"1", "/", 
     RowBox[{"L", "^", "2"}]}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"1", "/", "chimin"}], " ", "-", " ", 
      RowBox[{"1", "/", "chimax"}]}], ")"}]}]}], "//", 
  "FullSimplify"}]}], "Input",
 CellChangeTimes->{{3.967297049623064*^9, 3.967297077699317*^9}, {
  3.967297118627665*^9, 3.967297151241123*^9}, {3.9672971854443607`*^9, 
  3.96729718656863*^9}},
 CellLabel->"In[19]:=",ExpressionUUID->"b901ec3b-071a-490e-83b0-4bb544b6a6d7"],

