Cell[BoxData[
 RowBox[{
  RowBox[{"m1LoLo", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"m1LoLoElem", "[", 
      RowBox[{"i", ",", "j"}], "]"}], ",", 
     RowBox[{"{", 
