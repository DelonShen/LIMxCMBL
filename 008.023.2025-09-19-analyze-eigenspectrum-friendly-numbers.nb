Cell[CellGroupData[{

Cell["Only remove the mean", "Chapter",
 CellChangeTimes->{{3.9672039859851837`*^9, 
  3.967203998931369*^9}},ExpressionUUID->"2886eb75-e338-4295-bb8e-\
9659c5481672"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"$Assumptions", "=", "assume"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fmatm0", "[", 
   RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"KroneckerDelta", "[", 
     RowBox[{"i", ",", "j"}], "]"}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"1", "/", 
       RowBox[{"l", "[", "i", "]"}]}], " ", "-", 
      RowBox[{"1", "/", 
       RowBox[{"r", "[", "i", "]"}]}]}], ")"}], 
    RowBox[{"1", "/", 
     RowBox[{"dchi", "^", "2"}]}]}], " ", "+", " ", 
   RowBox[{
    RowBox[{"1", "/", 
     RowBox[{"L", "^", "2"}]}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"1", "/", "chimin"}], " ", "-", " ", 
      RowBox[{"1", "/", "chimax"}]}], ")"}]}], "-", " ", 
   RowBox[{
    RowBox[{"1", "/", 
     RowBox[{"(", 
      RowBox[{"L", " ", "dchi"}], ")"}]}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"1", "/", 
       RowBox[{"l", "[", "i", "]"}]}], "-", 
      RowBox[{"1", "/", 
       RowBox[{"r", "[", "i", "]"}]}], "+", 
      RowBox[{"1", "/", 
       RowBox[{"l", "[", "j", "]"}]}], "-", 
      RowBox[{"1", "/", 
       RowBox[{"r", "[", "j", "]"}]}]}], ")"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"covmatm0", "=", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"fmatm0", "[", 
        RowBox[{"i", ",", "j"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "nbins"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", "nbins"}], "}"}]}], "]"}], "//", 
     "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"also", " ", "could", " ", "use", " ", "rank"}], "-", "nullity"}],
    "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"MatrixRank", "[", "covmatm0", "]"}], "==", 
  RowBox[{"nbins", "-", "1"}]}]}], "Input",
 CellChangeTimes->{{3.967202958689118*^9, 3.967202991637524*^9}, {
   3.96720400879411*^9, 3.967204031421871*^9}, {3.967206324784418*^9, 
