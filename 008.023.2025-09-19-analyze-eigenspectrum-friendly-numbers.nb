Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"unfiltered", "=", 
  RowBox[{"DiagonalMatrix", "[", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"1", "/", 
       RowBox[{"dchi", "^", "2"}]}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"1", "/", 
         RowBox[{"l", "[", "i", "]"}]}], "-", 
        RowBox[{"1", "/", 
         RowBox[{"r", "[", "i", "]"}]}]}], ")"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "nbins"}], "}"}]}], "]"}], "]"}]}]], "Input",\

